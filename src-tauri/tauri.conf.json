{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TerraForge",
  "version": "0.2.0",
  "identifier": "win.aforgomon.terraforge",
  "build": {
    "beforeDevCommand": {
      "script": "node ../../scripts/build-web.mjs",
      "wait": true
    },
    "beforeBuildCommand": "node ../../scripts/build-web.mjs",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "TerraForge · 世界生成器",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 580,
        "decorations": true,
        "transparent": false,
        "theme": "Light",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
