{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TerraForge",
  "version": "0.1.0",
  "identifier": "win.aforgomon.terraforge",
  "build": {
    "beforeDevCommand": "cd ../apps/web && pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "TerraForge · 世界生成器",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}