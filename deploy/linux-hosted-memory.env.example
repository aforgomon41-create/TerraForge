# glibc settings for the small hosted Linux service. Load at process startup,
# for example with systemd EnvironmentFile=/path/to/this-file.
# Keep the service MemoryMax, job concurrency and simulation precision unchanged.
# Large field buffers should return to the OS after each operation; do not let
# export/import workloads raise the dynamic mmap threshold for subsequent jobs.
MALLOC_ARENA_MAX=2
MALLOC_MMAP_THRESHOLD_=131072
MALLOC_TRIM_THRESHOLD_=131072
